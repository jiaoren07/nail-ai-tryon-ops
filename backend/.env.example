# === 数据库 ===
DATABASE_URL=sqlite+aiosqlite:///./nail_demo.db

# === 图像生成 ===
# mock = 复制款式封面作为兜底（永远能跑、不花钱）
# seedream = 走 PPIO 的 Seedream 4.5 真实合成（用 PPIO_API_KEY 鉴权，~¥0.2/次）
IMAGE_PROVIDER=mock

# === LLM / VLM（PPIO 一家全包，OpenAI 兼容 API）===
PPIO_API_KEY=your_ppio_api_key_here
PPIO_BASE_URL=https://api.ppio.com/openai
LLM_QUICK_MODEL=qwen/qwen3-235b-a22b-instruct-2507
LLM_STRONG_MODEL=deepseek/deepseek-v4-pro
# 上传手图校验用的视觉模型（识别失败自动放行，不拦真实用户）
VLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# === 调度（true=启用 APScheduler，false=关闭定时任务，仅留手动触发）===
SCHEDULER_ENABLED=true

# === 公开部署护栏（本地开发保持默认即可）===
# 每日 04:30（北京时间）自动 reseed：重置访客改动 + 重锚时间窗口
DAILY_RESEED=false
# IMAGE_PROVIDER=seedream 时每天最多真实生成的张数，超出自动降级 mock
SEEDREAM_DAILY_QUOTA=30